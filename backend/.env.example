# ==============================================================================
# VetLink Veterinary Cloud & Local Configuration Template
# Copy this file to backend/.env and configure your local or production values.
# IMPORTANT: backend/.env is ignored by Git and will never be committed.
# ==============================================================================

# 1. Clinic SMTP Email Dispatch (Google Gmail)
# Requires Google Account 2-Step Verification and a 16-character App Password:
# (myaccount.google.com -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vetlinkemail@gmail.com
SMTP_PASSWORD=hpebkkptbjdmdszn
SMTP_FROM=vetlink.lamuan@gmail.com
SMTP_USE_TLS=true

# When SMTP credentials are empty, enables simulated queueing with PDF generation for offline/defense testing:
ALLOW_SIMULATED_EMAIL=true

# 2. Database Configuration
# Option A: Local XAMPP / MariaDB Development:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vetlink_db
DB_SSL=false

# Option B: Cloud MySQL (e.g., Aiven Cloud / Production):
# DB_HOST=mysql-xxxx-vetlink.aivencloud.com
# DB_PORT=15234
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_cloud_password
# DB_NAME=defaultdb
# DB_SSL=true

# 3. FastAPI Service Port
API_PORT=8000
